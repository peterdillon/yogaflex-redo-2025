<IfModule mod_rewrite.c>
RewriteEngine On

# Redirect HTTP to HTTPS and www to non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.yogaflexny\.com$ [NC]
RewriteRule ^(.*)$ https://yogaflexny.com/$1 [L,R=301]
</IfModule>

# CSP Header (only if HTTPS is active)
<IfModule mod_rewrite.c>
RewriteCond %{HTTPS} on
RewriteRule .* - [E=UPGRADE]
</IfModule>
<IfModule mod_headers.c>
Header always set Content-Security-Policy "upgrade-insecure-requests;" env=UPGRADE
</IfModule>

# Your existing Expires and compression rules (no change needed)
<IfModule mod_expires.c>
    ExpiresActive on
    # ... [keep your existing ExpiresByType rules] ...
</IfModule>

AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/css application/x-javascript application/javascript   